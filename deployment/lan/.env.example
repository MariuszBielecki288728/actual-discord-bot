# Discord application bot token (keep this secret)
DISCORD_TOKEN=replace-me
# Include formatted exception tracebacks in unexpected error replies. Disable in shared channels.
DISCORD_SHOW_ERROR_TRACEBACKS=true
DISCORD_BANK_NOTIFICATION_CHANNEL=bank-notifications
BANK_NOTIFICATION_TIMEZONE=Europe/Warsaw
DISCORD_BANK_IMPORT_CHANNEL=bank-imports
DISCORD_RECEIPT_CHANNEL=receipts
BANK_IMPORT_TIMEZONE=Europe/Warsaw

# Values configured in the Actual web application
ACTUAL_PASSWORD=replace-me
ACTUAL_FILE=My Finances
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_ACCOUNT=Pekao

# Local OCR settings
OCR_PROVIDER=tesseract
OCR_TESSERACT_LANG=pol
OCR_TESSERACT_PSM=6
